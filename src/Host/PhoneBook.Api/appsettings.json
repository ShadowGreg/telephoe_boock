{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "Npgsql": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/phonebook-.log", "rollingInterval": "Day", "restrictedToMinimumLevel": "Debug" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Contacts": "Host=localhost;Port=5432;Database=phonebook;Username=postgres;Password=postgres"
  },
  "Contacts": {
    "Storage": "JsonFile"
  },
  "ContactsFileStore": {
    "FilePath": "./data/contacts.json"
  }
}
